# Barrier configuration. Everything here is optional - with none of it set,
# Barrier runs rules-only and says so rather than pretending a model answered.
# Copy to .env and fill in what you have. Never commit the filled-in file.

# --- where state lives -------------------------------------------------------
BARRIER_DB=data/barrier.db
BARRIER_PORT=7777

# auto   consult the guard model unless the rules are already unambiguous
# always consult it on every write (use when measuring the model)
# off    rules and policy only
BARRIER_MODEL_MODE=auto

# --- the owned model ---------------------------------------------------------
# Easiest path: train + serve locally, then point Barrier at the server.
#   python training/guard_server.py train --base <model-id> --serve   # serves :7788
BARRIER_GUARD_URL=

# River credentials for training (and, optionally, hosted serving).
# Ask the River team; do not guess the base URL or model ids.
RIVER_API_KEY=
RIVER_BASE_URL=
RIVER_MODEL=
# Base model to fine-tune from (from `python training/guard_server.py models`)
RIVER_BASE_MODEL=

# --- Claude: screener before the fine-tune exists, and teacher for the data ---
ANTHROPIC_API_KEY=
BARRIER_TEACHER_MODEL=claude-sonnet-5

# --- live GBrain instead of the local protected store (adapter unverified) ----
GBRAIN_URL=
GBRAIN_TOKEN=

# --- QM security-screen proxy ------------------------------------------------
# QM presents this as a bearer token to POST /v1/qm/screen. Leave blank to
# accept unauthenticated calls (local demo only).
SECURITY_SCREEN_PROXY_TOKEN=

# --- Memorable (procedure gate client, not yet implemented) ------------------
MEMORABLE_API_KEY=
